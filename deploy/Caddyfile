{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		defer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	@public_host not host localhost 127.0.0.1
	header @public_host Strict-Transport-Security "max-age=31536000"

	@django path /api/* /_allauth/* /admin /admin/* /static/*
	handle @django {
		@admin_blocked {
			path /admin /admin/*
			not remote_ip {$ADMIN_ALLOWED_IPS:0.0.0.0/0 ::/0}
		}
		respond @admin_blocked 404
		reverse_proxy backend:8000
	}

	handle {
		header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
