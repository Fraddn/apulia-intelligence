{$SITE_ADDRESS} {
	encode zstd gzip

	@django path /api/* /_allauth/* /admin /admin/* /static/*
	handle @django {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
